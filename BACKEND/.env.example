[TEMPLATE]
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=false

# LLM Provider: groq | openai | gemini
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=
GEMINI_API_KEY=

# Sarvam AI fallback (answers normal requests when the primary LLM fails; optional)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
# Optional HuggingFace token (leave empty for public models)
HF_TOKEN=

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K_RETRIEVAL=20
RAG_RERANK_TOP_K=6
RAG_MIN_SIMILARITY=0.30

# File Upload
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=data/uploads

# Reports
REPORTS_DIR=data/reports
PUBLIC_BASE_URL=http://localhost:8000

# BHASHINI (optional; when unset, translation degrades openly with a warning)
BHASHINI_API_KEY=
BHASHINI_BASE_URL=

# Review-desk email (optional; without SMTP settings no email is sent and
# review creation is unaffected). For Gmail use an App Password, not the
# login password: Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Where expert-review request emails go.
REVIEW_NOTIFY_EMAIL=sayonsawbib@gmail.com
REVIEW_NOTIFY_FROM=

# Privacy / DPDP-aligned retention (privacy layer)# Version stamped on every consent record; bump it when the privacy notice changes
PRIVACY_NOTICE_VERSION=2026-09-1
# Retention windows in days. 0 = keep forever (never purge).
# Audit defaults to 0 on purpose: the audit trail is evidence - purging it must be explicit.
CHAT_RETENTION_DAYS=0
UPLOAD_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
# Default validity (days) of a granted paid-subscription / connector permission
SOURCE_CONSENT_DEFAULT_DAYS=365
# Per-dataset cap for GET /api/privacy/export
EXPORT_MAX_ITEMS=50000

# Response cache (in-process TTL; no Redis needed). Disable globally with
# CACHE_ENABLED=false. TTLs are staleness bounds, not correctness - cached
# payloads also carry a data revision (content hash / max row id).
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=2048
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_OVERVIEW_TTL_SECONDS=300
CACHE_DASHBOARD_TTL_SECONDS=60
CACHE_STATUS_TTL_SECONDS=30
CACHE_REGISTRY_TTL_SECONDS=300
CACHE_GRAPH_TTL_SECONDS=60
CACHE_EMBEDDING_TTL_SECONDS=600
# Chat answers: the cache key includes a data revision (corpus + product run
# history), so hits are never wrong by content - the TTL only bounds how long
# an identical question keeps the exact same wording.
CACHE_CHAT_TTL_SECONDS=600
# Reuse a COMPLETED analysis when the version content hash is unchanged
# instead of paying for a fresh LLM run (per-call opt-out: ?reuse=false).
CACHE_ANALYSIS_REUSE=true
